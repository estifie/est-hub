#!/usr/bin/env python3
"""est-balances: provider credit balances into the hub (owner Money tab).

Runs ON the Mac from launchd (every 6h): provider API keys never leave
this machine — they live in the login Keychain (service `est-balances`,
one generic-password item per provider) and only the balance numbers
ride ssh to the hub (`balances set`).

Providers: openrouter (GET /api/v1/credits), fal (GET
/v1/account/billing — needs an ADMIN key; inference keys 403),
replicate (manual: no documented balance endpoint — set
`EST_BALANCE_REPLICATE_AMOUNT` and the poller reports it as-is).

Every poll writes two hub objects: the display row (`balances set`,
free string for the Money tab) and a numeric reading on the
`balance-<provider>` alert check (`results report --value`). Balance
checks derive ok from the value against their thresholds (below
`crit_below`, else `warn_below`, pages) — the alerts actually fire.

One-time setup (keys never touch the shell history with a leading
space, or type them at the prompt `security` shows):

  security add-generic-password -s est-balances -a openrouter -w
  security add-generic-password -s est-balances -a fal -w

One-time alert setup per provider (thresholds live on the check; the
poller never stomps them — `checks add` refuses taken names, so this
runs once):

  est-hub checks add balance-openrouter --type balance --target openrouter \
      --owner sys --warn-below 5 --crit-below 1
  est-hub checks add balance-fal --type balance --target fal \
      --owner sys --warn-below 5 --crit-below 1
  est-hub checks add balance-replicate --type balance --target replicate \
      --owner sys --warn-below 5 --crit-below 1

Note: the loaded timer runs the COPY in ~/.local/bin (launchd cannot
read ~/Desktop) — re-copy after editing, then unload/load.

  ./scripts/est-balances            # poll + push
  ./scripts/est-balances --dry-run  # fetch only, no hub calls
  EST_BALANCE_OPENROUTER_KEY=... ./scripts/est-balances --dry-run  # no keychain
"""

import json
import os
import shlex
import subprocess
import sys
import urllib.request

HUB = os.environ.get("EST_HUB_URL", "http://100.120.126.23:18925")
SSH = os.environ.get("EST_HUB_SSH", "vps2")
BIN = os.environ.get("EST_HUB_BIN", "est-hub")
FETCH_TIMEOUT_S = 20
SSH_TIMEOUT_S = 30


def log(msg):
    print(f"est-balances: {msg}", file=sys.stderr, flush=True)


def read_key(provider):
    """The provider key: env override for probes, else the Keychain.
    Returns "" when unset (the provider skips, quietly-ish)."""
    env = os.environ.get(f"EST_BALANCE_{provider.upper()}_KEY", "")
    if env:
        return env
    try:
        out = subprocess.run(
            ["security", "find-generic-password",
             "-s", "est-balances", "-a", provider, "-w"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if out.returncode != 0:
        return ""
    return out.stdout.strip()


def fetch(url, key, scheme="Bearer"):
    """GET with an auth header. Returns (status, body); transport
    failures read (0, message). The key never lands in logs."""
    req = urllib.request.Request(
        url, headers={"Authorization": f"{scheme} {key}"})
    try:
        with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT_S) as r:
            return r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", "replace")[:500]
    except Exception as e:
        return 0, str(e)[:200]


def parse_openrouter(body):
    """Remaining credits: total minus usage (both USD). Raises
    ValueError on any shape drift — the provider changed, not us."""
    data = json.loads(body)["data"]
    return float(data["total_credits"]) - float(data["total_usage"])


def parse_fal(body):
    """Remaining credits from the billing expansion."""
    credits = json.loads(body)["credits"]
    return float(credits["current_balance"])


def parse_manual(body):
    """A hand-supplied amount (providers without a balance endpoint)."""
    return float(body)


PROVIDERS = {
    # provider: (label, url, auth scheme, parser)
    # url None means manual: the amount comes from
    # EST_BALANCE_<PROVIDER>_AMOUNT and no HTTP happens.
    "openrouter": (
        "OpenRouter",
        "https://openrouter.ai/api/v1/credits",
        "Bearer",
        parse_openrouter,
    ),
    "fal": (
        "fal.ai",
        "https://api.fal.ai/v1/account/billing?expand=credits",
        "Key",
        parse_fal,
    ),
    "replicate": (
        "Replicate",
        None,
        "Bearer",
        parse_manual,
    ),
}


def poll(provider):
    """Fetch one balance. Returns (amount, error): exactly one is set."""
    _, url, scheme, parse = PROVIDERS[provider]
    if url is None:
        raw = os.environ.get(f"EST_BALANCE_{provider.upper()}_AMOUNT", "").strip()
        if not raw:
            return None, f"manual: EST_BALANCE_{provider.upper()}_AMOUNT unset"
        try:
            return parse(raw), None
        except (ValueError, TypeError) as e:
            return None, f"unparseable manual amount ({e})"
    key = read_key(provider)
    if not key:
        return None, "no key in Keychain"
    status, body = fetch(url, key, scheme)
    if status == 401:
        return None, "rejected the key (401)"
    if status == 403:
        return None, "key lacks billing scope (403 — fal needs ADMIN)"
    if status != 200:
        return None, f"HTTP {status}: {body[:120]}"
    try:
        return parse(body), None
    except (KeyError, ValueError, TypeError) as e:
        return None, f"unparseable response ({e})"


def run(*args):
    remote = " ".join(shlex.quote(a) for a in ("est-hub",) + args)
    try:
        out = subprocess.run(
            ["ssh", "-n", SSH, remote], capture_output=True, text=True,
            timeout=SSH_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {SSH_TIMEOUT_S}s"
    return out.returncode, (out.stdout + out.stderr).strip()


def ensure_alert(provider):
    """The `balance-<provider>` alert check exists (thresholds are
    managed by hand — this never stomps them)."""
    code, err = run(
        "checks", "add", f"balance-{provider}",
        "--type", "balance", "--target", provider,
        "--owner", "sys",
        "--hub", HUB,
    )
    if code != 0 and "already exists" not in err:
        log(f"ensure balance-{provider} failed: {err}")
        return False
    return True


def push(provider, amount):
    label = PROVIDERS[provider][0]
    if not ensure_alert(provider):
        return False
    code, err = run(
        "balances", "set", provider,
        "--amount", f"{amount:.2f}",
        "--currency", "USD",
        "--label", label,
        "--note", "auto",
        "--hub", HUB,
    )
    if code != 0:
        log(f"push {provider} failed: {err}")
        return False
    # The numeric reading the alert check evaluates (ok is derived
    # hub-side from warn/crit — the flag rides along, ignored).
    code, err = run(
        "results", "report", "--check", f"balance-{provider}",
        "--ok", "--value", f"{amount:.2f}",
        "--reason", f"{label} ${amount:.2f}",
        "--hub", HUB,
    )
    if code != 0:
        log(f"report {provider} failed: {err}")
        return False
    print(f"{provider}: ${amount:.2f}")
    return True


def main():
    dry_run = "--dry-run" in sys.argv
    failed = False
    for provider in PROVIDERS:
        amount, err = poll(provider)
        if err is not None:
            if err == "no key in Keychain":
                log(f"{provider}: skipped ({err}; "
                    f"`security add-generic-password -s est-balances "
                    f"-a {provider} -w` to enable)")
                continue
            if err.startswith("manual: "):
                log(f"{provider}: skipped ({err[len('manual: '):]}; "
                    f"export it to enable)")
                continue
            log(f"{provider}: FAILED ({err})")
            failed = True
            continue
        if dry_run:
            print(f"would push: {provider} ${amount:.2f} (+ balance-{provider} reading)")
        elif not push(provider, amount):
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
