<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.estifie.hub-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/estifie/.local/bin/est-hub</string>
        <string>checks</string>
        <string>sync</string>
        <string>--ios-root</string>
        <string>/Users/estifie/Desktop/iOS</string>
        <string>--backend-root</string>
        <string>/Users/estifie/Desktop/iOS/backend</string>
        <string>--backend-url</string>
        <string>https://ub.estifie.com</string>
        <string>--hub</string>
        <string>http://100.120.126.23:18925</string>
    </array>
    <!-- Needs Tailscale running on this Mac (the tailnet hub URL is
         unreachable otherwise); quiet-fails to the log when it is off. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/est-hub-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/est-hub-sync.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/Users/estifie/.local/bin</string>
    </dict>
</dict>
</plist>
